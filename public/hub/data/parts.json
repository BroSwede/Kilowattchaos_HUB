{"model":{"name":"goBILDA StarterBot","variant":"mecanum","parts":418,"tris":28100556,"width":0.4521,"height":0.3093,"depth":0.452},"systems":[{"id":"launcher","name":"Launcher","blurb":"A Hogback wheel spun fast flings each ball up into the raised cell of the hive."},{"id":"ballpath","name":"Ball path","blurb":"Panels, a curved ramp and a servo carry each ball up to the flywheel, one at a time."},{"id":"intake","name":"Intake","blurb":"Gecko wheels and a row of flexible rollers grab balls off the floor and pull them in."},{"id":"drivetrain","name":"Drivetrain","blurb":"Four Yellow Jacket motors, one per yellow mecanum wheel. The angled rollers let the robot drive sideways without turning."},{"id":"structure","name":"Frame","blurb":"U-channel rails and brackets. Every hole sits on goBILDA’s 8 mm grid, so parts bolt on anywhere."},{"id":"power","name":"Power","blurb":"One 12 V battery runs every motor and servo on the robot."},{"id":"hardware","name":"Screws and bits","blurb":"Shafts, hubs, bearings, spacers and every screw that holds it together."}],"notes":{"15-Hole U-Channel":"Main side rails. The whole robot hangs off these two.","Dual Block Mount":"Small clamp block.","U-Channel":"Aluminium channel with the goBILDA hole pattern.","Standoff / Spacer":"Holds two parts a fixed distance apart.","Quad Block Mount":"Clamps a channel to a shaft or a motor.","Drive Motor":"19.2:1 Yellow Jacket motor. One drives each mecanum wheel, so all four can turn at different speeds.","Bearing / Collar":"Lets a shaft spin freely and keeps it in place.","Hub":"Locks a wheel or gear onto a shaft.","Hardware":"Screws, nuts and washers. On the real robot these are what you check before every match.","Mecanum Wheel":"Rollers set at 45 degrees. Spin the four wheels in different directions and the robot slides sideways.","8mm REX Shaft":"Hex shaft: the hex shape means wheels cannot slip.","Intake Roller":"Flexible rollers that sweep balls toward the middle.","Intake Motor":"50.9:1 Yellow Jacket motor, geared up through a big gear to spin the intake fast.","48mm Gecko Wheel":"Soft wheels that squash against a ball and pull it in.","20-Tooth Gear":"The small gear: five turns for every turn of the 100-tooth gear.","100-Tooth Gear":"Big gear on the motor drives a small gear on the intake shaft, which multiplies speed.","Compact ServoBlock":"Takes the side load off a servo's output shaft.","Speed Servo":"Spins continuously to run a corner wheel.","72mm Gecko Wheel":"Servo-driven wheels at the corners that steer balls inward.","Battery Mount":"Holds the battery in. A loose battery means a dead robot.","Launcher Mount":"Holds the flywheel and its motor rigid so every shot flies the same way.","Hopper Servo":"Moves to let one ball at a time reach the flywheel.","Launcher Motor":"Yellow Jacket motor that spins the flywheel. Your code sets how fast.","Flywheel":"A Hogback Wheel spun fast. Balls touch it for a split second and leave at speed.","12V Battery":"Everything on the robot runs from this pack. Charge it before every match.","Hopper Panel":"Thin sheet that keeps balls on the ball path.","Ramp Panel":"Curved sheet that guides balls up to the flywheel."},"parts":{"p000":["1120-0015-0384","structure","15-Hole U-Channel",48.0,48.0,384.0],"p001":["1120-0015-0384","structure","15-Hole U-Channel",48.0,48.0,384.0],"p002":["1205-0001-0005","structure","Dual Block Mount",12.0,43.0,9.5],"p003":["1205-0001-0005","structure","Dual Block Mount",12.0,43.0,9.5],"p004":["1205-0001-0005","structure","Dual Block Mount",12.0,9.5,43.0],"p005":["1205-0001-0005","structure","Dual Block Mount",12.0,9.5,43.0],"p006":["1121-0010-0264","structure","U-Channel",264.0,12.0,48.0],"p007":["1121-0010-0264","structure","U-Channel",264.0,48.0,12.0],"p008":["1222-0001-0001","structure","Standoff / Spacer",40.0,6.0,40.0],"p009":["1222-0001-0001","structure","Standoff / Spacer",40.0,6.0,40.0],"p010":["1201-0043-0002","structure","Quad Block Mount",43.0,43.0,12.0],"p011":["1201-0043-0002","