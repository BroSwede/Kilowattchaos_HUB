# Postgres connection string. In Vercel: Storage tab, add Neon (free), and this is set for you.
# Leave empty on a laptop to use the built-in PGlite database in .data/.
DATABASE_URL=
# A secret only you know. The first-time setup page asks for it before making the first mentor account.
SETUP_KEY=
# The team's time zone, for the daily check-in code and "today".
TEAM_TIMEZONE=America/New_York
